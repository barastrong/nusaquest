PORT=5000
NODE_ENV=development
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_SECRET_KEY=your_admin_secret_passcode_here

# WAJIB diisi untuk production. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Set sekali lalu JANGAN diubah lagi — mengubahnya membuat semua sesi login
# lama tidak berlaku (semua user ke-logout).
JWT_SECRET=your-long-random-jwt-secret

# Opsional: kunci AI untuk fitur "Generate Soal AI" di Admin Panel
GEMINI_API_KEY=your-gemini-api-key

# Opsional: proxy keluar (mis. server yang diblokir Google), pisahkan dengan koma
HTTPS_PROXY=

# Email pengirim kode OTP registrasi (Gmail: pakai App Password, bukan password akun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="NusaQuest" <your-gmail@gmail.com>
